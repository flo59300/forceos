#!/bin/sh
# =====================================================================
# ForceOS : paramètres de live-build (appelé par « lb config »)
# Conçu et développé par Florian Bigotte pour Force Ouvrière
# =====================================================================
set -e
. ./versions.conf

lb config noauto \
  --mode debian \
  --distribution "$DEBIAN_VERSION" \
  --architecture amd64 \
  --archive-areas "main contrib non-free-firmware" \
  --mirror-bootstrap "http://deb.debian.org/debian/" \
  --mirror-binary "http://deb.debian.org/debian/" \
  --security true \
  --updates true \
  --firmware-binary true \
  --firmware-chroot true \
  --linux-flavours amd64 \
  --binary-images iso-hybrid \
  --bootloaders "grub-efi syslinux" \
  --debian-installer live \
  --debian-installer-gui true \
  --debian-installer-distribution "$DEBIAN_VERSION" \
  --bootappend-live "boot=live components quiet splash locales=fr_FR.UTF-8 keyboard-layouts=fr timezone=Europe/Paris" \
  --bootappend-install "locale=fr_FR.UTF-8 keymap=fr cdrom-detect/try-usb=true quiet" \
  --iso-application "ForceOS" \
  --iso-publisher "Florian Bigotte pour Force Ouvrière" \
  --iso-volume "ForceOS $FORCEOS_VERSION" \
  --memtest none \
  --win32-loader false \
  --cache-packages true \
  "${@}"
