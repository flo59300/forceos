<?xml version="1.0" encoding="UTF-8"?>
<!-- ForceOS : modèle de lettre à la direction (Florian Bigotte pour Force Ouvrière) -->
<office:document xmlns:office="urn:oasis:names:tc:opendocument:xmlns:office:1.0"
  xmlns:style="urn:oasis:names:tc:opendocument:xmlns:style:1.0"
  xmlns:text="urn:oasis:names:tc:opendocument:xmlns:text:1.0"
  xmlns:fo="urn:oasis:names:tc:opendocument:xmlns:xsl-fo-compatible:1.0"
  xmlns:svg="urn:oasis:names:tc:opendocument:xmlns:svg-compatible:1.0"
  xmlns:draw="urn:oasis:names:tc:opendocument:xmlns:drawing:1.0"
  xmlns:xlink="http://www.w3.org/1999/xlink"
  xmlns:meta="urn:oasis:names:tc:opendocument:xmlns:meta:1.0"
  xmlns:dc="http://purl.org/dc/elements/1.1/"
  office:version="1.3" office:mimetype="application/vnd.oasis.opendocument.text">
 <office:meta>
  <dc:title>Lettre à la direction</dc:title>
  <meta:initial-creator>ForceOS (Florian Bigotte)</meta:initial-creator>
 </office:meta>
 <office:font-face-decls>
  <style:font-face style:name="Carlito" svg:font-family="Carlito" style:font-family-generic="swiss"/>
 </office:font-face-decls>
 <office:styles>
  <style:default-style style:family="paragraph">
   <style:paragraph-properties fo:hyphenation-ladder-count="no-limit"/>
   <style:text-properties style:font-name="Carlito" fo:font-size="11pt" fo:language="fr" fo:country="FR"/>
  </style:default-style>
  <style:style style:name="Standard" style:family="paragraph">
   <style:paragraph-properties fo:margin-top="0cm" fo:margin-bottom="0.15cm" fo:line-height="115%"/>
  </style:style>
  <style:style style:name="Corps" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:text-align="justify" fo:margin-bottom="0.3cm"/>
  </style:style>
  <style:style style:name="Section" style:family="paragraph" style:parent-style-name="Standard">
   <style:text-properties fo:font-size="13pt" fo:font-weight="bold" fo:color="#002B7F"/>
  </style:style>
  <style:style style:name="Filet" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-bottom="0.6cm" fo:padding-bottom="0.1cm" fo:border-bottom="1.5pt solid #E2001A"/>
   <style:text-properties fo:font-size="9.5pt" fo:color="#4A5670"/>
  </style:style>
  <style:style style:name="Droite" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-left="9.5cm"/>
  </style:style>
  <style:style style:name="Mention" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-top="0.5cm"/>
   <style:text-properties fo:font-weight="bold" fo:font-size="10pt"/>
  </style:style>
  <style:style style:name="Objet" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-top="0.6cm" fo:margin-bottom="0.5cm"/>
  </style:style>
  <style:style style:name="Signature" style:family="paragraph" style:parent-style-name="Droite">
   <style:paragraph-properties fo:margin-top="0.8cm"/>
  </style:style>
  <style:style style:name="Pied" style:family="paragraph" style:parent-style-name="Standard">
   <style:paragraph-properties fo:margin-top="1.2cm" fo:padding-top="0.1cm" fo:border-top="0.5pt solid #002B7F" fo:text-align="center"/>
   <style:text-properties fo:font-size="8.5pt" fo:color="#4A5670"/>
  </style:style>
 </office:styles>
 <office:automatic-styles>
  <style:page-layout style:name="A4">
   <style:page-layout-properties fo:page-width="21cm" fo:page-height="29.7cm"
     fo:margin-top="1.5cm" fo:margin-bottom="1.5cm" fo:margin-left="2.2cm" fo:margin-right="2.2cm"/>
  </style:page-layout>
  <style:style style:name="Gras" style:family="text"><style:text-properties fo:font-weight="bold"/></style:style>
  <style:style style:name="Aide" style:family="text"><style:text-properties fo:color="#E2001A" fo:font-style="italic"/></style:style>
  <style:style style:name="Logo" style:family="graphic">
   <style:graphic-properties style:wrap="left" style:vertical-pos="top" style:horizontal-pos="right" style:horizontal-rel="paragraph"/>
  </style:style>
  <style:style style:name="P1" style:family="paragraph" style:master-page-name="Principale" style:parent-style-name="Section"/>
 </office:automatic-styles>
 <office:master-styles>
  <style:master-page style:name="Principale" style:page-layout-name="A4"/>
 </office:master-styles>
 <office:body>
  <office:text>
   <text:p text:style-name="P1"><draw:frame draw:style-name="Logo" draw:name="Logo" text:anchor-type="paragraph" svg:width="2.3cm" svg:height="2.3cm"><draw:image><office:binary-data></office:binary-data></draw:image></draw:frame>Syndicat FO</text:p>
   <text:p text:style-name="Standard">Stellantis Valenciennes</text:p>
   <text:p text:style-name="Standard">Adresse du local syndical</text:p>
   <text:p text:style-name="Filet">Téléphone · adresse e-mail du syndicat</text:p>

   <text:p text:style-name="Droite"><text:span text:style-name="Gras">Monsieur le Directeur du site</text:span></text:p>
   <text:p text:style-name="Droite">Stellantis Valenciennes</text:p>
   <text:p text:style-name="Droite">Adresse de l’établissement</text:p>
   <text:p text:style-name="Droite">Code postal Ville</text:p>
   <text:p text:style-name="Droite"/>
   <text:p text:style-name="Droite">À Valenciennes, le JJ mois AAAA</text:p>

   <text:p text:style-name="Mention">Lettre recommandée avec accusé de réception</text:p>
   <text:p text:style-name="Mention">Ou remise en main propre contre décharge</text:p>

   <text:p text:style-name="Objet"><text:span text:style-name="Gras">Objet : </text:span>objet précis du courrier</text:p>
   <text:p text:style-name="Standard"><text:span text:style-name="Gras">Références : </text:span>article du Code du travail, accord ou réunion concernés (date du CSE, etc.)</text:p>
   <text:p text:style-name="Standard"/>

   <text:p text:style-name="Corps">Monsieur le Directeur,</text:p>
   <text:p text:style-name="Corps">Par la présente, le syndicat FO souhaite attirer votre attention sur <text:span text:style-name="Aide">[exposez les faits de façon précise et datée]</text:span>.</text:p>
   <text:p text:style-name="Corps">Cette situation n’est pas conforme à <text:span text:style-name="Aide">[texte applicable : Code du travail, convention collective, accord d’entreprise, règlement intérieur]</text:span>, qui prévoit que <text:span text:style-name="Aide">[citez la disposition]</text:span>.</text:p>
   <text:p text:style-name="Corps">En conséquence, nous vous demandons <text:span text:style-name="Aide">[demande claire et mesurable]</text:span> dans un délai de <text:span text:style-name="Aide">[nombre]</text:span> jours à compter de la réception de ce courrier.</text:p>
   <text:p text:style-name="Corps">À défaut de réponse dans ce délai, le syndicat FO se réserve la possibilité d’inscrire ce point à l’ordre du jour du prochain CSE et d’engager toute démarche utile à la défense des salariés.</text:p>
   <text:p text:style-name="Corps">Nous restons à votre disposition pour en échanger et vous prions d’agréer, Monsieur le Directeur, l’expression de nos salutations distinguées.</text:p>

   <text:p text:style-name="Signature">Pour le syndicat FO,</text:p>
   <text:p text:style-name="Droite">Prénom NOM</text:p>
   <text:p text:style-name="Droite">Fonction (secrétaire, délégué syndical…)</text:p>

   <text:p text:style-name="Pied">Syndicat FO · Stellantis Valenciennes · Ensemble, + FOrts !</text:p>
  </office:text>
 </office:body>
</office:document>
