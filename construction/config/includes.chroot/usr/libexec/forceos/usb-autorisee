#!/usr/bin/env bash
# =====================================================================
# ForceOS : contrôle d'une interface de stockage USB (appelé par udev)
# Conçu et développé par Florian Bigotte pour Force Ouvrière
#
# Un périphérique est reconnu par fabricant, modèle et numéro de série.
# S'il ne figure pas dans /etc/forceos/usb-autorisees, son interface de
# stockage est désactivée par le noyau et il est noté dans
# /run/forceos/usb-bloquees pour que l'administrateur puisse l'autoriser.
# =====================================================================
set -u
# Système « live » (démarré depuis la clé d'installation) : aucun contrôle,
# sinon la clé de démarrage elle-même serait coupée.
grep -qw 'boot=live' /proc/cmdline && exit 0

INTF=/sys${1:?}
DEV=$(dirname "$INTF")
lire() { { tr -d '\n' < "$DEV/$1"; } 2>/dev/null | tr -c '[:alnum:] ._-' '_'; }
VENDEUR=$(lire idVendor); PRODUIT=$(lire idProduct); SERIE=$(lire serial)
CLE="$VENDEUR:$PRODUIT:${SERIE:-sans-numero}"

# Sans numéro de série, un périphérique ne peut pas être distingué d'un autre
# du même modèle : il n'est jamais autorisé.
if [[ -n $SERIE ]] && awk -v c="$CLE" '$1 == c {t=1} END {exit !t}' /etc/forceos/usb-autorisees 2>/dev/null; then
  exit 0
fi

echo 0 > "$INTF/authorized" 2>/dev/null
install -d -m 0755 /run/forceos /run/forceos/usb-bloquees
{
  echo "CLE=$CLE"
  echo "INTERFACE=$1"
  echo "NOM=$(lire manufacturer) $(lire product)"
  echo "DATE=$(date '+%d/%m/%Y %H:%M')"
} > "/run/forceos/usb-bloquees/${CLE//:/_}"
logger -t forceos-usb "Stockage USB non autorisé bloqué : $CLE"
exit 0
