#!/usr/bin/env bash
# =====================================================================
# ForceOS : autorisation d'un périphérique de stockage USB bloqué
# Conçu et développé par Florian Bigotte pour Force Ouvrière
# Appelé par pkexec (mot de passe administrateur) depuis forceos-usb-autoriser.
#   usb-autoriser-racine <fichier bloqué> <libellé>
# =====================================================================
set -euo pipefail
NOM=${1:?}; LIBELLE=${2:-clé USB}
[[ $NOM =~ ^[[:alnum:]._-]+$ ]] || { echo "Nom invalide." >&2; exit 2; }
F=/run/forceos/usb-bloquees/$NOM
[[ -f $F ]] || { echo "Ce périphérique n'est plus branché." >&2; exit 2; }
CLE=$(sed -n 's/^CLE=//p' "$F"); INTERFACE=$(sed -n 's/^INTERFACE=//p' "$F")
[[ $CLE =~ ^[[:xdigit:]]{4}:[[:xdigit:]]{4}:[[:alnum:]._-]+$ ]] || { echo "Identifiant invalide." >&2; exit 2; }
[[ $CLE == *:sans-numero ]] && { echo "Ce périphérique n'a pas de numéro de série : il ne peut pas être autorisé." >&2; exit 3; }
LIBELLE=$(printf '%s' "$LIBELLE" | LC_ALL=C.UTF-8 sed 's/[^[:alnum:][:space:].,_-]/_/g' | LC_ALL=C.UTF-8 cut -c1-60)

awk -v c="$CLE" '$1 == c {t=1} END {exit !t}' /etc/forceos/usb-autorisees 2>/dev/null \
  || printf '%s  # %s, autorisée le %s\n' "$CLE" "$LIBELLE" "$(date +%d/%m/%Y)" >> /etc/forceos/usb-autorisees
chmod 0644 /etc/forceos/usb-autorisees
[[ -e /sys$INTERFACE/authorized ]] && echo 1 > "/sys$INTERFACE/authorized"
rm -f "$F"
logger -t forceos-usb "Stockage USB autorisé par l'administrateur : $CLE ($LIBELLE)"
