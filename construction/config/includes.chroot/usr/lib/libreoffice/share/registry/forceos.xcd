<?xml version="1.0" encoding="UTF-8"?>
<!-- ForceOS : LibreOffice ne garde pas la liste des documents récents (Florian Bigotte) -->
<oor:data xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:oor="http://openoffice.org/2001/registry">
 <dependency file="main"/>
 <oor:component-data oor:package="org.openoffice.Office" oor:name="Common">
  <node oor:name="History">
   <prop oor:name="PickListSize" oor:finalized="true"><value>0</value></prop>
   <prop oor:name="RecentDocsThumbnail" oor:finalized="true"><value>false</value></prop>
  </node>
 </oor:component-data>
</oor:data>
