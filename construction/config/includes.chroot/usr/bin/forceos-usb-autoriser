#!/usr/bin/env bash
# =====================================================================
# ForceOS : autoriser une clé USB (mot de passe administrateur)
# Conçu et développé par Florian Bigotte pour Force Ouvrière
# =====================================================================
set -u
TITRE="Autoriser une clé USB"
mapfile -t FICHIERS < <(ls -1 /run/forceos/usb-bloquees 2>/dev/null)
if (( ${#FICHIERS[@]} == 0 )); then
  zenity --info --title="$TITRE" --width=420 \
    --text="Aucune clé USB bloquée n'est branchée.\n\nBranchez la clé à autoriser, puis relancez cet outil."
  exit 0
fi
LIGNES=()
for f in "${FICHIERS[@]}"; do
  LIGNES+=("$f" "$(sed -n 's/^NOM=//p' "/run/forceos/usb-bloquees/$f")" "$(sed -n 's/^DATE=//p' "/run/forceos/usb-bloquees/$f")")
done
CHOIX=$(zenity --list --title="$TITRE" --width=640 --height=320 \
  --text="Clés USB bloquées sur ce poste. Seul l'administrateur peut en autoriser une." \
  --column=Identifiant --column=Modèle --column="Branchée le" --hide-column=1 --print-column=1 \
  "${LIGNES[@]}") || exit 0
[[ -n $CHOIX ]] || exit 0
LIBELLE=$(zenity --entry --title="$TITRE" --text="Nom de cette clé (par exemple : clé de la trésorière) :") || exit 0
if ERR=$(pkexec /usr/libexec/forceos/usb-autoriser-racine "$CHOIX" "$LIBELLE" 2>&1); then
  zenity --info --title="$TITRE" --text="La clé est autorisée. Elle apparaît dans le gestionnaire de fichiers."
else
  zenity --error --title="$TITRE" --text="Autorisation impossible.\n\n${ERR:-Mot de passe administrateur refusé.}"
fi
