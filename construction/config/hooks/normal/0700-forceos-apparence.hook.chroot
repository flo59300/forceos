#!/bin/sh
# =====================================================================
# ForceOS : identité visuelle, bureau Cinnamon, navigateur et nettoyage des traces
# Conçu et développé par Florian Bigotte pour Force Ouvrière
# =====================================================================
set -e

# --- Droits des scripts ForceOS ------------------------------------------
chmod 0755 /usr/bin/forceos-* /usr/libexec/forceos/* /etc/X11/Xsession.d/55forceos-xdg
chmod 0644 /etc/skel/Bureau/*.desktop 2>/dev/null || true
chmod 0755 /etc/skel/Bureau/*.desktop

# --- Icônes -------------------------------------------------------------------
gtk-update-icon-cache -f -q /usr/share/icons/hicolor || true

# --- Bureau Cinnamon : thème Linux Mint et réglages par défaut ForceOS ------------
for t in Mint-Y Mint-Y-Blue Mint-Y-Dark-Blue ForceOS; do
  test -f "/usr/share/themes/$t/index.theme" || { echo "thème $t absent" >&2; exit 1; }
done
# --- Disposition « dock » : barre fine en haut, dock flottant centré en bas -----
# Seulement si le dock (plank) est installé ; sinon la barre du bas classique
# de Cinnamon reste en place.
if [ -x /usr/bin/plank ] && [ -f /usr/share/plank/themes/ForceOS/dock.theme ]; then
  cat > /etc/dconf/db/local.d/10-forceos-dock <<'DOCK'
# ForceOS : disposition « dock » (Florian Bigotte), générée par le crochet 0700
[org/cinnamon]
panels-enabled=['1:0:top']
panels-height=['1:30']
enabled-applets=['panel1:left:0:menu@cinnamon.org:0', 'panel1:left:1:workspace-switcher@cinnamon.org:1', 'panel1:center:0:calendar@cinnamon.org:2', 'panel1:right:0:systray@cinnamon.org:3', 'panel1:right:1:xapp-status@cinnamon.org:4', 'panel1:right:2:notifications@cinnamon.org:5', 'panel1:right:3:removable-drives@cinnamon.org:6', 'panel1:right:4:keyboard@cinnamon.org:7', 'panel1:right:5:network@cinnamon.org:8', 'panel1:right:6:sound@cinnamon.org:9', 'panel1:right:7:power@cinnamon.org:10', 'panel1:right:8:user@cinnamon.org:11']

[net/launchpad/plank/docks/dock1]
theme='ForceOS'
position='bottom'
alignment='center'
icon-size=46
zoom-enabled=true
zoom-percent=135
hide-mode='window-dodge'
pressure-reveal=false
show-dock-item=false
lock-items=false
dock-items=['forceos-fo-gestion.dockitem', 'librewolf.dockitem', 'nemo.dockitem', 'libreoffice-writer.dockitem', 'libreoffice-calc.dockitem', 'thunderbird.dockitem', 'forceos-reglages.dockitem']
DOCK
else
  rm -f /etc/xdg/autostart/forceos-dock.desktop
  printf "[org/cinnamon]\npanels-height=['1:40']\n" > /etc/dconf/db/local.d/10-forceos-dock
  echo "plank absent : barre du bas classique conservée" >&2
fi
dconf update
# Barre du bas : FO Gestion, navigateur, fichiers et traitement de texte épinglés
# (valeur par défaut de l'applet Cinnamon, reprise par chaque nouveau compte)
GWL=/usr/share/cinnamon/applets/grouped-window-list@cinnamon.org/settings-schema.json
if [ -f "$GWL" ] && jq -e '."pinned-apps"' "$GWL" >/dev/null; then
  jq '."pinned-apps".default = ["forceos-fo-gestion.desktop", "librewolf.desktop", "nemo.desktop", "libreoffice-writer.desktop"]' "$GWL" > "$GWL.tmp"
  mv "$GWL.tmp" "$GWL"
else
  echo "applet grouped-window-list : réglage pinned-apps introuvable" >&2
fi
# Cinnamon devient la session par défaut ; l'ancien écran de connexion est retiré
update-alternatives --set x-session-manager /usr/bin/cinnamon-session 2>/dev/null || true
apt-get purge -y lightdm-gtk-greeter 2>/dev/null || true

# --- Dossier « Bureautique » prêt dans chaque nouveau compte -------------------
# Copie des lanceurs installés ; premiere-session complète le dossier et lui
# donne son icône au premier démarrage.
mkdir -p /etc/skel/Bureau/Bureautique
for id in libreoffice-writer libreoffice-calc libreoffice-impress libreoffice-draw \
          scribus org.gnome.Evince com.github.johnfactotum.Foliate \
          com.github.jeromerobert.pdfarranger pdfarranger \
          simple-scan org.gnome.SimpleScan org.gnome.Calculator \
          thunderbird org.mozilla.Thunderbird org.keepassxc.KeePassXC; do
  [ -f "/usr/share/applications/$id.desktop" ] || continue
  install -m 0755 "/usr/share/applications/$id.desktop" "/etc/skel/Bureau/Bureautique/$id.desktop"
done
echo "Dossier Bureautique : $(ls /etc/skel/Bureau/Bureautique | tr '\n' ' ')"

# --- Démarrage : plus de fond d'écran Debian 13 dans GRUB --------------------
# Le thème de desktop-base (logo Debian) est désactivé ; le menu est caché
# par /etc/default/grub.d/50-forceos.cfg.
[ -f /etc/grub.d/05_debian_theme ] && chmod -x /etc/grub.d/05_debian_theme

# --- Démarrage : thème Plymouth ForceOS (logo sur pastille blanche) ---------
# La phrase de chiffrement du disque est saisie sur cet écran.
if [ -d /usr/share/plymouth/themes/spinner ]; then
  rm -rf /usr/share/plymouth/themes/forceos
  cp -a /usr/share/plymouth/themes/spinner /usr/share/plymouth/themes/forceos
  mv /usr/share/plymouth/themes/forceos/spinner.plymouth /usr/share/plymouth/themes/forceos/forceos.plymouth
  # Le fichier d'origine écrit « themes//spinner » : le chemin est réécrit en entier
  sed -i -e '/^Name\[/d' -e 's/^Name=.*/Name=ForceOS/' \
         -e 's/^Description=.*/Description=Démarrage ForceOS (Florian Bigotte)/' \
         -e 's#^ImageDir=.*#ImageDir=/usr/share/plymouth/themes/forceos#' \
         -e 's/^Font=.*/Font=Carlito 13/' -e 's/^TitleFont=.*/TitleFont=Carlito 28/' \
         -e 's/^BackgroundStartColor=.*/BackgroundStartColor=0x002B7F/' \
         -e 's/^BackgroundEndColor=.*/BackgroundEndColor=0x001D57/' \
         -e 's/^WatermarkVerticalAlignment=.*/WatermarkVerticalAlignment=.2/' \
         -e 's/^DialogVerticalAlignment=.*/DialogVerticalAlignment=.62/' \
         -e 's/^TitleVerticalAlignment=.*/TitleVerticalAlignment=.62/' \
         /usr/share/plymouth/themes/forceos/forceos.plymouth
  install -m 0644 /usr/share/forceos/images/watermark.png /usr/share/plymouth/themes/forceos/watermark.png
  plymouth-set-default-theme forceos
fi

# --- Navigateur LibreWolf -------------------------------------------------------
# Lancé directement (sans Firejail) ; ancien lanceur intermédiaire retiré
rm -f /usr/local/bin/librewolf /usr/local/share/applications/librewolf.desktop
test -x /usr/bin/librewolf || { echo "LibreWolf absent de /usr/bin" >&2; exit 1; }
/usr/libexec/forceos/librewolf-politiques
update-alternatives --set x-www-browser /usr/bin/librewolf 2>/dev/null || true

# --- Réseau : résolveur filtrant -----------------------------------------------
systemctl enable forceos-dns.service

# --- Nettoyage des traces à chaque ouverture et fermeture de session ------------
systemctl --global enable forceos-nettoyage.service

# --- Démarrage : prise en compte du thème ----------------------------------------
update-initramfs -u -k all || true
